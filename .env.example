# --- Neon PostgreSQL ---
# Pooled connection string from Neon dashboard (recommended for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-long-random-string"
# Base URL — http://localhost:3000 in dev, your Vercel URL in prod
AUTH_URL="http://localhost:3000"
# Trust the AUTH_URL host in dev / behind a proxy
AUTH_TRUST_HOST="true"

# --- Google Sign-In (Identity Services / ID-token flow) ---
# Only the Client ID is needed — we use Google Identity Services on the
# client to obtain an ID token and verify it server-side against Google's
# public JWKs with `jose`. No client secret required, no OAuth callback URL
# to whitelist.
#
# In Google Cloud Console:
#   APIs & Services → Credentials → Web client →
#     Authorized JavaScript origins:
#       http://localhost:3000
#       https://<your-vercel-domain>
#     (Authorized redirect URIs are NOT required for this flow.)
#
# Leave AUTH_GOOGLE_ID blank to hide the Google button entirely.
AUTH_GOOGLE_ID=""

# --- OTP ---
# "mock"  -> codes logged to server console (dev)
# "msg91" -> real SMS via MSG91 (fill keys below)
OTP_PROVIDER="mock"
OTP_EXPIRY_SECONDS="180"
OTP_LENGTH="6"
OTP_MAX_ATTEMPTS="5"

# MSG91 (only if OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# --- Optional ---
# Pin to a single OSRM routing endpoint (e.g. a self-hosted instance).
# Leave blank to fall back through the public mirrors.
NEXT_PUBLIC_OSRM_URL=""

# Override the Overpass API endpoint similarly. Default cycles three mirrors.
OVERPASS_URL=""
